prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 200
        repeat-rate 40
    }
}

layout {
    background-color "#1e1e2e"
}

// Launch Quickshell with your greeter config
// greetd waits for this niri to exit before starting the user session, so
// quit it as soon as the greeter hands off.
spawn-sh-at-startup "quickshell -p /etc/greetd/quickshell/shell.qml; niri msg action quit --skip-confirmation"

// Disable hotkeys you do not want available on the login screen
binds {
    Mod+Shift+E { quit; }
}